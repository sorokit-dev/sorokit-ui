{
    "name":  "@sorokit/ui",
    "version":  "0.1.0",
    "description":  "A modular library of pre-built, accessible UI components for Stellar dApps, built on @sorokit/core.",
    "type":  "module",
    "main":  "./dist/index.cjs",
    "module":  "./dist/index.js",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js",
                              "require":  "./dist/index.cjs"
                          },
                    "./tailwind-preset":  "./tailwind-preset.cjs",
                    "./styles.css":  "./dist/styles.css"
                },
    "files":  [
                  "dist",
                  "tailwind-preset.cjs"
              ],
    "scripts":  {
                    "dev":  "vite build --watch",
                    "build":  "tsc --emitDeclarationOnly && vite build",
                    "test":  "vitest run",
                    "verify:package":  "node scripts/verify-package.mjs",
                    "lint":  "eslint src --ext .ts,.tsx",
                    "typecheck":  "tsc --noEmit"
                },
    "peerDependencies":  {
                             "react":  ">=18",
                             "react-dom":  ">=18",
                             "@sorokit/core":  ">=0.1.0"
                         },
    "dependencies":  {
                         "@radix-ui/react-dialog":  "^1.1.1",
                         "@radix-ui/react-toast":  "^1.2.1",
                         "clsx":  "^2.1.1"
                     },
    "devDependencies":  {
                            "@sorokit/core":  "file:../sorokit-core",
                            "@types/react":  "^18.3.0",
                            "@types/react-dom":  "^18.3.0",
                            "@vitejs/plugin-react":  "^4.3.1",
                            "autoprefixer":  "^10.4.19",
                            "postcss":  "^8.4.38",                            "react":  "^18.3.1",
                            "react-dom":  "^18.3.1",                            "tailwindcss":  "^3.4.4",
                            "typescript":  "^5.5.0",
                            "vite":  "^5.3.0",
                            "vite-plugin-dts":  "^3.9.1",
                            "vitest":  "^1.6.0"
                        }
}
